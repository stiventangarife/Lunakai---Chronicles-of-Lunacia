# Apache configuration for Lunakai: Chronicles of Lunacia

# Enable MIME types for 3D Models and Modern Web Formats
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType application/wasm .wasm
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/webp .webp
  AddType audio/mpeg .mp3
  AddType audio/ogg .ogg
  AddType audio/wav .wav
</IfModule>

# Enable CORS for assets
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, OPTIONS"
  Header set Access-Control-Allow-Headers "*"

  # Browser Cache Optimization
  <FilesMatch "\.(glb|gltf|png|jpg|jpeg|webp|svg|mp3|wav|ogg|wasm|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/wasm
</IfModule>

# Prevent directory browsing
Options -Indexes

# Default file
DirectoryIndex index.html
