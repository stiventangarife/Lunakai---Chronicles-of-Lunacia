# Apache configuration for Lunakai: Chronicles of Lunacia

# Enable MIME types for 3D Models and Modern Web Formats
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType application/wasm .wasm
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/webp .webp
  AddType image/ktx2 .ktx2
  AddType audio/mpeg .mp3
  AddType audio/ogg .ogg
  AddType audio/wav .wav
</IfModule>

# Enable CORS for assets
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, OPTIONS"
  Header set Access-Control-Allow-Headers "*"

  # Browser Cache Optimization (Hito 109)
  # Modelos, audio, texturas KTX2 y binarios: un año sin volver a preguntar. El juego pide estos archivos con
  # ?v=ASSET_VERSION (src/render/AssetVersion.js), así que al subir la versión la URL cambia y se descargan de nuevo.
  # REGLA: si cambias algo en assets/, sube ASSET_VERSION antes de subir el juego.
  <FilesMatch "\.(glb|gltf|bin|ktx2|mp3|wav|ogg|wasm|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Imágenes: se guardan, pero el navegador pregunta si cambiaron (respuesta 304 sin descarga si siguen igual).
  # Los iconos y retratos de la interfaz se piden sin ?v=, así que así se actualizan solos al subir el juego.
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|gif)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Código del juego: el navegador siempre pregunta si hay una versión nueva (con ETag, sin volver a descargar si no cambió).
  # Evita mezclar archivos de dos versiones tras subir una build (p. ej. main.js nuevo con Spells.js viejo).
  <FilesMatch "\.(js|mjs|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/wasm
</IfModule>

# Prevent directory browsing
Options -Indexes

# Default file
DirectoryIndex index.html
