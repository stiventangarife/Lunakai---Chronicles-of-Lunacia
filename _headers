/*
  Access-Control-Allow-Origin: *

/*.glb
  Content-Type: model/gltf-binary
  Cache-Control: public, max-age=31536000, immutable

/*.gltf
  Content-Type: model/gltf+json
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Content-Type: application/wasm

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
